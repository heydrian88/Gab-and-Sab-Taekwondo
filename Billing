<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BillPulse - Modern SaaS Billing & Invoicing</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                        },
                        brand: {
                            50: '#eff6ff',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full bg-slate-50 font-sans text-slate-800 antialiased overflow-x-hidden">

    <div id="app" class="min-h-full flex flex-col">
        
        <!-- ==================== AUTH & LOGIN SCREEN ==================== -->
        <div id="auth-screen" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 border border-slate-100">
                <div class="text-center mb-8">
                    <div class="inline-flex items-center justify-center w-14 h-14 bg-brand-50 rounded-xl text-brand-600 text-2xl font-bold mb-3 shadow-inner">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-slate-900">BillPulse SaaS</h1>
                    <p class="text-sm text-slate-500 mt-1">Professional billing & invoice management</p>
                </div>

                <!-- Tabs -->
                <div class="flex rounded-xl bg-slate-100 p-1 mb-6">
                    <button id="tab-login" onclick="switchAuthTab('login')" class="flex-1 py-2 text-sm font-semibold rounded-lg bg-white text-slate-800 shadow-sm transition">Sign In</button>
                    <button id="tab-signup" onclick="switchAuthTab('signup')" class="flex-1 py-2 text-sm font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition">Create Account</button>
                </div>

                <!-- Form -->
                <form id="auth-form" onsubmit="handleAuthSubmit(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Email Address</label>
                        <input type="email" id="auth-email" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm" placeholder="you@company.com">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Password</label>
                        <input type="password" id="auth-password" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm" placeholder="••••••••">
                    </div>
                    
                    <div id="signup-fields" class="hidden space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Company / Business Name</label>
                            <input type="text" id="auth-company" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm" placeholder="Acme Corp">
                        </div>
                    </div>

                    <button type="submit" id="auth-submit-btn" class="w-full mt-2 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl shadow-lg shadow-brand-500/25 transition">
                        Sign In to Dashboard
                    </button>
                </form>

                <div class="mt-6 pt-6 border-t border-slate-100 text-center">
                    <button onclick="openAdminModal()" class="text-xs font-medium text-slate-500 hover:text-brand-600 transition inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-shield-halved text-brand-500"></i> Admin Access Override
                    </button>
                </div>
            </div>
        </div>

        <!-- ==================== MAIN DASHBOARD LAYOUT ==================== -->
        <div id="main-layout" class="hidden flex-1 flex h-full">
            
            <!-- Sidebar Navigation -->
            <aside class="w-64 bg-navy-900 text-slate-300 flex flex-col flex-shrink-0 border-r border-slate-800">
                <div class="p-6 flex items-center justify-between border-b border-slate-800/80">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-brand-600 text-white rounded-xl flex items-center justify-center font-bold text-lg shadow-lg shadow-brand-600/30">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div>
                            <span class="font-bold text-white text-lg tracking-tight block">BillPulse</span>
                            <span class="text-[10px] uppercase font-semibold text-brand-400 tracking-widest">Enterprise SaaS</span>
                        </div>
                    </div>
                </div>

                <nav class="flex-1 px-4 py-6 space-y-1.5">
                    <a href="#dashboard" onclick="switchNav('dashboard')" id="nav-dashboard" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition bg-brand-600 text-white shadow-lg shadow-brand-600/20">
                        <i class="fa-solid fa-chart-pie w-5 text-center"></i> Dashboard
                    </a>
                    <a href="#invoices" onclick="switchNav('invoices')" id="nav-invoices" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition text-slate-400 hover:bg-navy-800 hover:text-white">
                        <i class="fa-solid fa-file-invoice-dollar w-5 text-center"></i> Invoices
                    </a>
                    <a href="#create-invoice" onclick="switchNav('create-invoice')" id="nav-create-invoice" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition text-slate-400 hover:bg-navy-800 hover:text-white">
                        <i class="fa-solid fa-circle-plus w-5 text-center"></i> New Invoice
                    </a>
                    <a href="#clients" onclick="switchNav('clients')" id="nav-clients" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition text-slate-400 hover:bg-navy-800 hover:text-white">
                        <i class="fa-solid fa-users w-5 text-center"></i> Clients
                    </a>
                    <a href="#payments" onclick="switchNav('payments')" id="nav-payments" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition text-slate-400 hover:bg-navy-800 hover:text-white">
                        <i class="fa-solid fa-credit-card w-5 text-center"></i> Payments
                    </a>
                    <a href="#settings" onclick="switchNav('settings')" id="nav-settings" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition text-slate-400 hover:bg-navy-800 hover:text-white">
                        <i class="fa-solid fa-gear w-5 text-center"></i> Settings
                    </a>
                </nav>

                <!-- Sidebar Footer User Card -->
                <div class="p-4 m-4 bg-navy-800/80 rounded-xl border border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <div class="w-9 h-9 rounded-lg bg-brand-500/20 text-brand-400 flex items-center justify-center font-bold text-sm flex-shrink-0" id="user-avatar-initials">
                            US
                        </div>
                        <div class="truncate">
                            <p class="text-xs font-semibold text-white truncate" id="sidebar-user-name">User Account</p>
                            <p class="text-[10px] text-slate-400 truncate" id="sidebar-user-email">user@domain.com</p>
                        </div>
                    </div>
                    <button onclick="logoutUser()" title="Sign Out" class="text-slate-400 hover:text-rose-400 p-2 transition">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="flex-1 flex flex-col min-w-0 bg-slate-50">
                
                <!-- Top Header -->
                <header class="h-20 bg-white border-b border-slate-200 px-8 flex items-center justify-between sticky top-0 z-30 shadow-xs">
                    <div class="flex items-center gap-4">
                        <h2 id="page-title" class="text-xl font-bold text-slate-800 tracking-tight">Dashboard Overview</h2>
                        <span id="account-badge" class="px-2.5 py-1 bg-brand-50 text-brand-600 rounded-full text-xs font-semibold border border-brand-100">Live Account Scope</span>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="relative hidden sm:block">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="fa-solid fa-search text-xs"></i>
                            </span>
                            <input type="text" placeholder="Search invoices, clients..." class="pl-9 pr-4 py-2 bg-slate-100 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white w-64 transition">
                        </div>
                        
                        <!-- Notifications -->
                        <button class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 transition relative">
                            <i class="fa-regular fa-bell"></i>
                            <span class="absolute top-2 right-2 w-2 h-2 bg-rose-500 rounded-full"></span>
                        </button>

                        <!-- Main Admin Log In Button top right -->
                        <button onclick="openAdminModal()" class="px-4 py-2 bg-navy-900 hover:bg-navy-800 text-white rounded-xl text-sm font-semibold shadow-md flex items-center gap-2 transition">
                            <i class="fa-solid fa-shield-halved text-brand-400"></i> Admin Log In
                        </button>
                    </div>
                </header>

                <!-- Dynamic View Container -->
                <main class="flex-1 overflow-y-auto p-8">
                    
                    <!-- ================= VIEW: DASHBOARD ================= -->
                    <div id="view-dashboard" class="space-y-6">
                        <!-- Stats Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Revenue</span>
                                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
                                        <i class="fa-solid fa-wallet"></i>
                                    </div>
                                </div>
                                <h3 class="text-2xl font-bold text-slate-800" id="stat-total-revenue">₱0.00</h3>
                                <p class="text-xs text-emerald-600 font-medium mt-1 flex items-center gap-1">
                                    <i class="fa-solid fa-arrow-trend-up"></i> +12.4% from last month
                                </p>
                            </div>
                            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pending Invoices</span>
                                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                                        <i class="fa-solid fa-clock"></i>
                                    </div>
                                </div>
                                <h3 class="text-2xl font-bold text-slate-800" id="stat-pending-invoices">0</h3>
                                <p class="text-xs text-slate-500 mt-1">Awaiting client payment</p>
                            </div>
                            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Paid Invoices</span>
                                    <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">
                                        <i class="fa-solid fa-circle-check"></i>
                                    </div>
                                </div>
                                <h3 class="text-2xl font-bold text-slate-800" id="stat-paid-invoices">0</h3>
                                <p class="text-xs text-slate-500 mt-1">Successfully settled</p>
                            </div>
                            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Clients</span>
                                    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
                                        <i class="fa-solid fa-users"></i>
                                    </div>
                                </div>
                                <h3 class="text-2xl font-bold text-slate-800" id="stat-total-clients">0</h3>
                                <p class="text-xs text-slate-500 mt-1">Active accounts</p>
                            </div>
                        </div>

                        <!-- Recent Invoices & Quick Actions -->
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
                                <div class="flex items-center justify-between mb-6">
                                    <h3 class="font-bold text-slate-800 text-lg">Recent Invoices</h3>
                                    <button onclick="switchNav('invoices')" class="text-xs font-semibold text-brand-600 hover:text-brand-700">View All</button>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="border-b border-slate-100 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                                                <th class="pb-3">Invoice #</th>
                                                <th class="pb-3">Client</th>
                                                <th class="pb-3">Due Date</th>
                                                <th class="pb-3">Amount</th>
                                                <th class="pb-3">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody id="recent-invoices-tbody" class="text-sm divide-y divide-slate-100">
                                            <!-- Dynamically populated -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Quick Launch Card -->
                            <div class="bg-gradient-to-br from-navy-900 to-navy-800 text-white rounded-2xl p-6 shadow-xl flex flex-col justify-between">
                                <div>
                                    <span class="px-3 py-1 bg-brand-500/20 text-brand-400 rounded-full text-xs font-semibold border border-brand-500/30">Fast Workflow</span>
                                    <h3 class="text-xl font-bold mt-4 mb-2">Create New Invoice</h3>
                                    <p class="text-sm text-slate-300 leading-relaxed">Generate tax-compliant invoices with live 12% calculation and instant client assignment.</p>
                                </div>
                                <div class="mt-8">
                                    <button onclick="switchNav('create-invoice')" class="w-full py-3 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-xl shadow-lg shadow-brand-600/30 transition flex items-center justify-center gap-2">
                                        <i class="fa-solid fa-plus"></i> New Invoice Builder
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ================= VIEW: INVOICES ================= -->
                    <div id="view-invoices" class="hidden space-y-6">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                            <div>
                                <h3 class="text-xl font-bold text-slate-800">Invoice History</h3>
                                <p class="text-sm text-slate-500">All invoices scoped securely to your account ID</p>
                            </div>
                            <button onclick="switchNav('create-invoice')" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl text-sm shadow-md transition flex items-center gap-2">
                                <i class="fa-solid fa-plus"></i> Create Invoice
                            </button>
                        </div>

                        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                                            <th class="py-4 px-6">Invoice #</th>
                                            <th class="py-4 px-6">Client</th>
                                            <th class="py-4 px-6">Issue Date</th>
                                            <th class="py-4 px-6">Due Date</th>
                                            <th class="py-4 px-6">Total Due</th>
                                            <th class="py-4 px-6">Status</th>
                                            <th class="py-4 px-6 text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="full-invoices-tbody" class="text-sm divide-y divide-slate-100">
                                        <!-- Dynamically populated -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ================= VIEW: CREATE INVOICE (INTERACTIVE BUILDER) ================= -->
                    <div id="view-create-invoice" class="hidden space-y-6 max-w-5xl mx-auto">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-xl font-bold text-slate-800">Interactive Invoice Builder</h3>
                                <p class="text-sm text-slate-500">Build professional invoices with real-time computation & validation</p>
                            </div>
                            <button onclick="switchNav('invoices')" class="text-sm font-medium text-slate-500 hover:text-slate-800">Cancel</button>
                        </div>

                        <form id="invoice-builder-form" onsubmit="handleSaveAndSendInvoice(event)" class="space-y-6">
                            <!-- Top Metadata Card -->
                            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Select Client *</label>
                                    <div class="flex gap-2">
                                        <select id="inv-client-select" required class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm bg-white">
                                            <option value="">-- Choose Client --</option>
                                        </select>
                                        <button type="button" onclick="openNewClientModal()" class="px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition" title="Add New Client">
                                            <i class="fa-solid fa-user-plus"></i>
                                        </button>
                                    </div>
                                    <span id="err-client" class="text-xs text-rose-500 mt-1 hidden">Please select a valid client.</span>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Issue Date *</label>
                                    <input type="date" id="inv-issue-date" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Due Date *</label>
                                    <input type="date" id="inv-due-date" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
                                    <span id="err-duedate" class="text-xs text-rose-500 mt-1 hidden">Due date cannot be earlier than issue date.</span>
                                </div>
                            </div>

                            <!-- Dynamic Items Table -->
                            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4">
                                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                                    <h4 class="font-bold text-slate-800 text-base">Invoice Line Items</h4>
                                    <button type="button" onclick="addInvoiceLineItem()" class="px-3 py-1.5 bg-brand-50 hover:bg-brand-100 text-brand-600 rounded-lg text-xs font-semibold transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-plus"></i> Add Line Item
                                    </button>
                                </div>

                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="text-[11px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100">
                                                <th class="pb-3 w-5/12">Description</th>
                                                <th class="pb-3 w-2/12">Quantity</th>
                                                <th class="pb-3 w-2/12">Rate (₱)</th>
                                                <th class="pb-3 w-2/12">Amount</th>
                                                <th class="pb-3 w-1/12 text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="line-items-tbody" class="divide-y divide-slate-100">
                                            <!-- Line rows injected via JS -->
                                        </tbody>
                                    </table>
                                </div>
                                <span id="err-items" class="text-xs text-rose-500 block hidden">At least one valid line item is required.</span>
                            </div>

                            <!-- Summary Calculation Card -->
                            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs flex flex-col md:flex-row items-center justify-between gap-6">
                                <div class="w-full md:w-1/2">
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Payment Terms & Notes</label>
                                    <textarea id="inv-notes" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Thank you for your business. Please remit payment within 30 days."></textarea>
                                </div>
                                
                                <div class="w-full md:w-1/2 bg-slate-50 p-6 rounded-xl border border-slate-200 space-y-3">
                                    <div class="flex justify-between text-sm text-slate-600">
                                        <span>Subtotal:</span>
                                        <span class="font-semibold text-slate-800" id="calc-subtotal">₱0.00</span>
                                    </div>
                                    <div class="flex justify-between text-sm text-slate-600">
                                        <span>Tax (12%):</span>
                                        <span class="font-semibold text-slate-800" id="calc-tax">₱0.00</span>
                                    </div>
                                    <div class="pt-3 border-t border-slate-200 flex justify-between text-base font-bold text-slate-900">
                                        <span>Total Due:</span>
                                        <span class="text-brand-600 text-xl" id="calc-total">₱0.00</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Bar -->
                            <div class="flex items-center justify-end gap-4 pt-2">
                                <button type="button" onclick="switchNav('invoices')" class="px-6 py-3 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-semibold rounded-xl text-sm transition">
                                    Save as Draft
                                </button>
                                <button type="submit" class="px-8 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl text-sm shadow-lg shadow-brand-600/30 transition flex items-center gap-2">
                                    <i class="fa-solid fa-paper-plane"></i> Save and Send Invoice
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- ================= VIEW: CLIENTS ================= -->
                    <div id="view-clients" class="hidden space-y-6">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                            <div>
                                <h3 class="text-xl font-bold text-slate-800">Client Directory</h3>
                                <p class="text-sm text-slate-500">Manage client organizations and contacts</p>
                            </div>
                            <button onclick="openNewClientModal()" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl text-sm shadow-md transition flex items-center gap-2">
                                <i class="fa-solid fa-user-plus"></i> Add New Client
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="clients-grid">
                            <!-- Dynamically populated client cards -->
                        </div>
                    </div>

                    <!-- ================= VIEW: PAYMENTS ================= -->
                    <div id="view-payments" class="hidden space-y-6">
