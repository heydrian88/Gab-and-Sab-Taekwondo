    <!-- ================= APPLICATION LOGIC ================= -->
    <script>
        let currentUser = null;
        let dbClients = [];
        let dbInvoices = [];
        let dbPayments = [];

        // Sample initial data generator per user
        function getStorageKey(key) {
            return `billpulse_${currentUser.id}_${key}`;
        }

        function loadUserData() {
            if (!currentUser) return;
            
            const storedClients = localStorage.getItem(getStorageKey('clients'));
            const storedInvoices = localStorage.getItem(getStorageKey('invoices'));
            const storedPayments = localStorage.getItem(getStorageKey('payments'));

            if (storedClients) {
                dbClients = JSON.parse(storedClients);
            } else {
                dbClients = [
                    { id: 'cli_1', name: 'Acme Global Corp', email: 'accounts@acmeglobal.com', phone: '+1 (555) 019-2834' },
                    { id: 'cli_2', name: 'Apex Innovations', email: 'billing@apexinnovations.io', phone: '+63 917 888 9911' },
                    { id: 'cli_3', name: 'Vertex Studios', email: 'finance@vertexstudio.net', phone: '+44 20 7946 0918' }
                ];
                saveClients();
            }

            if (storedInvoices) {
                dbInvoices = JSON.parse(storedInvoices);
            } else {
                dbInvoices = [
                    { 
                        id: 'INV-2026-001', 
                        clientId: 'cli_1', 
                        clientName: 'Acme Global Corp', 
                        issueDate: '2026-10-01', 
                        dueDate: '2026-10-31', 
                        items: [{ desc: 'Cloud Infrastructure Setup & Migration', qty: 1, rate: 45000, amount: 45000 }],
                        subtotal: 45000, 
                        tax: 5400, 
                        total: 50400, 
                        status: 'Paid',
                        notes: 'Thank you for your business.'
                    },
                    { 
                        id: 'INV-2026-002', 
                        clientId: 'cli_2', 
                        clientName: 'Apex Innovations', 
                        issueDate: '2026-10-05', 
                        dueDate: '2026-11-05', 
                        items: [{ desc: 'SaaS Enterprise Subscription - Q4', qty: 5, rate: 7500, amount: 37500 }],
                        subtotal: 37500, 
                        tax: 4500, 
                        total: 42000, 
                        status: 'Pending',
                        notes: 'Payable via bank transfer.'
                    }
                ];
                saveInvoices();
            }

            if (storedPayments) {
                dbPayments = JSON.parse(storedPayments);
            } else {
                dbPayments = [
                    { id: 'PAY-88219', invoiceId: 'INV-2026-001', clientName: 'Acme Global Corp', date: '2026-10-02', method: 'Bank Wire Transfer', amount: 50400, status: 'Successful' }
                ];
                savePayments();
            }
        }

        function saveClients() {
            if (!currentUser) return;
            localStorage.setItem(getStorageKey('clients'), JSON.stringify(dbClients));
        }

        function saveInvoices() {
            if (!currentUser) return;
            localStorage.setItem(getStorageKey('invoices'), JSON.stringify(dbInvoices));
        }

        function savePayments() {
            if (!currentUser) return;
            localStorage.setItem(getStorageKey('payments'), JSON.stringify(dbPayments));
        }

        function switchAuthTab(tab) {
            const loginBtn = document.getElementById('tab-login');
            const signupBtn = document.getElementById('tab-signup');
            const signupFields = document.getElementById('signup-fields');
            const submitBtn = document.getElementById('auth-submit-btn');

            if (tab === 'login') {
                loginBtn.className = "flex-1 py-2 text-sm font-semibold rounded-lg bg-white text-slate-800 shadow-sm transition";
                signupBtn.className = "flex-1 py-2 text-sm font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition";
                signupFields.classList.add('hidden');
                submitBtn.innerText = "Sign In to Dashboard";
            } else {
                signupBtn.className = "flex-1 py-2 text-sm font-semibold rounded-lg bg-white text-slate-800 shadow-sm transition";
                loginBtn.className = "flex-1 py-2 text-sm font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition";
                signupFields.classList.remove('hidden');
                submitBtn.innerText = "Create Account & Start";
            }
        }

        function handleAuthSubmit(e) {
            e.preventDefault();
            const email = document.getElementById('auth-email').value.trim();
            const password = document.getElementById('auth-password').value;
            const company = document.getElementById('auth-company').value.trim() || 'My SaaS Business';

            // Create or authenticate user session
            currentUser = {
                id: 'usr_' + btoa(email).substring(0, 10).toLowerCase().replace(/[^a-z0-9]/g, ''),
                email: email,
                name: company,
                isAdmin: false
            };

            completeLogin();
        }

        function openAdminModal() {
            document.getElementById('admin-modal').classList.remove('hidden');
            document.getElementById('admin-modal').classList.add('flex');
            document.getElementById('admin-pass-input').value = '';
            document.getElementById('admin-pass-input').focus();
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
            document.getElementById('admin-modal').classList.remove('flex');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const pass = document.getElementById('admin-pass-input').value;
            if (pass === 'cuteako') {
                closeAdminModal();
                currentUser = {
                    id: 'usr_admin_master',
                    email: 'admin@billpulse.io',
                    name: 'Master Admin Hub',
                    isAdmin: true
                };
                showToast('Admin override successful!', 'success');
                completeLogin();
            } else {
                showToast('Incorrect master password!', 'error');
            }
        }

        function completeLogin() {
            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('main-layout').classList.remove('hidden');
            
            // Update UI elements
            document.getElementById('sidebar-user-name').innerText = currentUser.name;
            document.getElementById('sidebar-user-email').innerText = currentUser.email;
            document.getElementById('user-avatar-initials').innerText = currentUser.name.substring(0, 2).toUpperCase();
            
            if (currentUser.isAdmin) {
                document.getElementById('account-badge').innerText = 'Admin Master Scope';
                document.getElementById('account-badge').className = 'px-2.5 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-semibold border border-amber-200';
            }

            loadUserData();
            switchNav('dashboard');
            showToast(`Welcome back, ${currentUser.name}!`, 'success');
        }

        function logoutUser() {
            currentUser = null;
            document.getElementById('main-layout').classList.add('hidden');
            document.getElementById('auth-screen').classList.remove('hidden');
            document.getElementById('auth-form').reset();
            showToast('Signed out securely.', 'success');
        }

        function switchNav(viewId) {
            // Update active nav styling
            document.querySelectorAll('.nav-link').forEach(el => {
                el.className = "nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition text-slate-400 hover:bg-navy-800 hover:text-white";
            });
            const activeNav = document.getElementById('nav-' + viewId);
            if (activeNav) {
                activeNav.className = "nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition bg-brand-600 text-white shadow-lg shadow-brand-600/20";
            }

            // Toggle view panels
            const views = ['dashboard', 'invoices', 'create-invoice', 'clients', 'payments', 'settings'];
            views.forEach(v => {
                const el = document.getElementById('view-' + v);
                if (el) el.classList.add('hidden');
            });

            const targetView = document.getElementById('view-' + viewId);
            if (targetView) targetView.classList.remove('hidden');

            // Set Title
            const titles = {
                'dashboard': 'Dashboard Overview',
                'invoices': 'Invoice Management',
                'create-invoice': 'Interactive Invoice Builder',
                'clients': 'Client Directory',
                'payments': 'Payment Transactions',
                'settings': 'Account Settings'
            };
            document.getElementById('page-title').innerText = titles[viewId] || 'Dashboard';

            // Trigger specific view loaders
            if (viewId === 'dashboard') renderDashboard();
            if (viewId === 'invoices') renderInvoicesList();
            if (viewId === 'create-invoice') initInvoiceBuilder();
            if (viewId === 'clients') renderClientsList();
            if (viewId === 'payments') renderPaymentsList();
            if (viewId === 'settings') initSettings();
        }

        function renderDashboard() {
            const totalRev = dbInvoices.filter(i => i.status === 'Paid').reduce((acc, curr) => acc + curr.total, 0);
            const pendingCount = dbInvoices.filter(i => i.status === 'Pending').length;
            const paidCount = dbInvoices.filter(i => i.status === 'Paid').length;
            
            document.getElementById('stat-total-revenue').innerText = '₱' + totalRev.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('stat-pending-invoices').innerText = pendingCount;
            document.getElementById('stat-paid-invoices').innerText = paidCount;
            document.getElementById('stat-total-clients').innerText = dbClients.length;

            // Recent invoices table
            const tbody = document.getElementById('recent-invoices-tbody');
            tbody.innerHTML = '';
            
            const recent = dbInvoices.slice(-5).reverse();
            if (recent.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-400 text-sm">No invoices recorded yet.</td></tr>`;
                return;
            }

            recent.forEach(inv => {
                const statusBadge = inv.status === 'Paid' 
                    ? `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-600 rounded-full text-xs font-semibold">Paid</span>`
                    : `<span class="px-2.5 py-1 bg-amber-50 text-amber-600 rounded-full text-xs font-semibold">Pending</span>`;

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="py-3.5 font-semibold text-slate-800">${inv.id}</td>
                        <td class="py-3.5 text-slate-600">${inv.clientName}</td>
                        <td class="py-3.5 text-slate-500">${inv.dueDate}</td>
                        <td class="py-3.5 font-bold text-slate-800">₱${inv.total.toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                        <td class="py-3.5">${statusBadge}</td>
                    </tr>
                `;
            });
        }

        function renderInvoicesList() {
            const tbody = document.getElementById('full-invoices-tbody');
            tbody.innerHTML = '';

            if (dbInvoices.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400 text-sm">No invoices found. Create your first invoice!</td></tr>`;
                return;
            }

            dbInvoices.forEach(inv => {
                const statusBadge = inv.status === 'Paid' 
                    ? `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-600 rounded-full text-xs font-semibold border border-emerald-100">Paid</span>`
                    : `<span class="px-2.5 py-1 bg-amber-50 text-amber-600 rounded-full text-xs font-semibold border border-amber-100">Pending</span>`;

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="py-4 px-6 font-semibold text-slate-800">${inv.id}</td>
                        <td class="py-4 px-6 text-slate-700 font-medium">${inv.clientName}</td>
                        <td class="py-4 px-6 text-slate-500">${inv.issueDate}</td>
                        <td class="py-4 px-6 text-slate-500">${inv.dueDate}</td>
                        <td class="py-4 px-6 font-bold text-slate-800">₱${inv.total.toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                        <td class="py-4 px-6">${statusBadge}</td>
                        <td class="py-4 px-6 text-right space-x-2">
                            <button onclick="markInvoicePaid('${inv.id}')" title="Toggle Status" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg transition"><i class="fa-solid fa-check text-xs"></i></button>
                            <button onclick="deleteInvoice('${inv.id}')" title="Delete Invoice" class="p-2 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg transition"><i class="fa-solid fa-trash text-xs"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

        function markInvoicePaid(id) {
            const inv = dbInvoices.find(i => i.id === id);
            if (inv) {
                inv.status = inv.status === 'Paid' ? 'Pending' : 'Paid';
                saveInvoices();
                renderInvoicesList();
                showToast(`Invoice ${id} status updated to ${inv.status}`, 'success');
            }
        }

        function deleteInvoice(id) {
            if (confirm(`Are you sure you want to delete invoice ${id}?`)) {
                dbInvoices = dbInvoices.filter(i => i.id !== id);
                saveInvoices();
                renderInvoicesList();
                showToast(`Invoice ${id} deleted.`, 'success');
            }
        }

        let invoiceLineItems = [];

        function initInvoiceBuilder() {
            // Populate client dropdown
            const select = document.getElementById('inv-client-select');
            select.innerHTML = '<option value="">-- Choose Client --</option>';
            dbClients.forEach(c => {
                select.innerHTML += `<option value="${c.id}">${c.name} (${c.email})</option>`;
            });

            // Set default dates
            const today = new Date().toISOString().split('T')[0];
            const nextMonth = new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0];
            document.getElementById('inv-issue-date').value = today;
            document.getElementById('inv-due-date').value = nextMonth;

            // Reset items & add one default row
            invoiceLineItems = [
                { id: Date.now(), desc: 'Professional SaaS Consulting Services', qty: 1, rate: 15000 }
            ];
            renderLineItemsTable();
        }

        function addInvoiceLineItem() {
            invoiceLineItems.push({ id: Date.now() + Math.random(), desc: '', qty: 1, rate: 0 });
            renderLineItemsTable();
        }

        function removeInvoiceLineItem(id) {
            if (invoiceLineItems.length <= 1) {
                showToast('Invoice must contain at least one line item.', 'error');
                return;
            }
            invoiceLineItems = invoiceLineItems.filter(item => item.id !== id);
            renderLineItemsTable();
        }

        function updateLineItemField(id, field, value) {
            const item = invoiceLineItems.find(i => i.id === id);
            if (item) {
                if (field === 'qty' || field === 'rate') {
                    item[field] = parseFloat(value) || 0;
                } else {
                    item[field] = value;
                }
                renderLineItemsTable(false); // redraw summaries without re-rendering inputs
            }
        }

        function renderLineItemsTable(fullRedraw = true) {
            const tbody = document.getElementById('line-items-tbody');
            
            if (fullRedraw) {
                tbody.innerHTML = '';
                invoiceLineItems.forEach(item => {
                    const amount = item.qty * item.rate;
                    tbody.innerHTML += `
                        <tr class="item-row" data-id="${item.id}">
                            <td class="py-3 pr-4">
                                <input type="text" value="${item.desc}" oninput="updateLineItemField(${item.id}, 'desc', this.value)" placeholder="Item description or service..." required class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </td>
                            <td class="py-3 pr-4">
                                <input type="number" min="1" value="${item.qty}" oninput="updateLineItemField(${item.id}, 'qty', this.value)" required class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 item-qty">
                            </td>
                            <td class="py-3 pr-4">
                                <input type="number" min="0" step="0.01" value="${item.rate}" oninput="updateLineItemField(${item.id}, 'rate', this.value)" required class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 item-rate">
                            </td>
                            <td class="py-3 pr-4 font-semibold text-slate-800 item-amount" id="amount-${item.id}">
                                ₱${(item.qty * item.rate).toLocaleString('en-US', {minimumFractionDigits: 2})}
                            </td>
                            <td class="py-3 text-right">
                                <button type="button" onclick="removeInvoiceLineItem(${item.id})" class="p-2 text-rose-500 hover:bg-rose-50 rounded-lg transition">
                                    <i class="fa-solid fa-trash text-xs"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
            } else {
                // Just update amounts dynamically without losing focus
                invoiceLineItems.forEach(item => {
                    const amountEl = document.getElementById(`amount-${item.id}`);
                    if (amountEl) {
                        amountEl.innerText = '₱' + (item.qty * item.rate).toLocaleString('en-US', {minimumFractionDigits: 2});
                    }
                });
            }

            // Live calculation summary
            let subtotal = invoiceLineItems.reduce((acc, curr) => acc + (curr.qty * curr.rate), 0);
            let tax = subtotal * 0.12; // 12% Tax
            let total = subtotal + tax;

            document.getElementById('calc-subtotal').innerText = '₱' + subtotal.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('calc-tax').innerText = '₱' + tax.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('calc-total').innerText = '₱' + total.toLocaleString('en-US', {minimumFractionDigits: 2});
        }

        function handleSaveAndSendInvoice(e) {
            e.preventDefault();
            
            // Real-time validation checks
            const clientSelect = document.getElementById('inv-client-select').value;
            const issueDate = document.getElementById('inv-issue-date').value;
            const dueDate = document.getElementById('inv-due-date').value;

            let hasError = false;

            if (!clientSelect) {
                document.getElementById('err-client').classList.remove('hidden');
                hasError = true;
            } else {
                document.getElementById('err-client').classList.add('hidden');
            }

            if (dueDate < issueDate) {
                document.getElementById('err-duedate').classList.remove('hidden');
                hasError = true;
            } else {
                document.getElementById('err-duedate').classList.add('hidden');
            }

            // Validate line items
            let validItems = [];
            let itemError = false;
            invoiceLineItems.forEach(item => {
                if (!item.desc.trim() || item.qty <= 0 || item.rate < 0) {
                    itemError = true;
                }
                validItems.push({
                    desc: item.desc,
                    qty: item.qty,
                    rate: item.rate,
                    amount: item.qty * item.rate
                });
            });

            if (itemError || validItems.length === 0) {
                document.getElementById('err-items').classList.remove('hidden');
                hasError = true;
            } else {
                document.getElementById('err-items').classList.add('hidden');
            }

            if (hasError) {
                showToast('Please correct validation errors before saving.', 'error');
                return;
            }

            // Compute final
            let subtotal = validItems.reduce((acc, curr) => acc + curr.amount, 0);
            let tax = subtotal * 0.12;
            let total = subtotal + tax;

            const clientObj = dbClients.find(c => c.id === clientSelect);
            const newInvoiceId = 'INV-2026-' + Math.floor(100 + Math.random() * 900);

            const newInvoice = {
                id: newInvoiceId,
                clientId: clientSelect,
                clientName: clientObj ? clientObj.name : 'Unknown Client',
                issueDate: issueDate,
                dueDate: dueDate,
                items: validItems,
                subtotal: subtotal,
                tax: tax,
                total: total,
                status: 'Pending',
                notes: document.getElementById('inv-notes').value
            };

            dbInvoices.push(newInvoice);
            saveInvoices();

            // Also record payment intent log
            dbPayments.push({
                id: 'PAY-' + Math.floor(10000 + Math.random() * 90000),
                invoiceId: newInvoiceId,
                clientName: newInvoice.clientName,
                date: issueDate,
                method: 'Pending Gateway',
                amount: total,
                status: 'Unpaid'
            });
            savePayments();

            showToast(`Invoice ${newInvoiceId} successfully saved & sent!`, 'success');
            switchNav('invoices');
        }

        function renderClientsList() {
            const grid = document.getElementById('clients-grid');
            grid.innerHTML = '';

            if (dbClients.length === 0) {
                grid.innerHTML = `<div class="col-span-3 text-center py-8 text-slate-400">No clients found.</div>`;
                return;
            }

            dbClients.forEach(c => {
                grid.innerHTML += `
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between space-y-4">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">
                                    <i class="fa-solid fa-building"></i>
                                </div>
                                <button onclick="deleteClient('${c.id}')" class="text-slate-400 hover:text-rose-500 transition"><i class="fa-solid fa-trash text-xs"></i></button>
                            </div>
                            <h4 class="font-bold text-slate-800 text-lg">${c.name}</h4>
                            <p class="text-sm text-slate-500 mt-1 flex items-center gap-1.5"><i class="fa-solid fa-envelope text-xs text-slate-400"></i> ${c.email}</p>
                            <p class="text-sm text-slate-500 mt-1 flex items-center gap-1.5"><i class="fa-solid fa-phone text-xs text-slate-400"></i> ${c.phone || 'No phone'}</p>
                        </div>
                        <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full">Active Account</span>
                            <button onclick="quickInvoiceForClient('${c.id}')" class="text-xs font-semibold text-slate-700 hover:text-brand-600 transition">Create Invoice →</button>
                        </div>
                    </div>
                `;
            });
        }

        function openNewClientModal() {
            document.getElementById('client-modal').classList.remove('hidden');
            document.getElementById('client-modal').classList.add('flex');
            document.getElementById('new-client-name').value = '';
            document.getElementById('new-client-email').value = '';
            document.getElementById('new-client-phone').value = '';
        }

        function closeNewClientModal() {
            document.getElementById('client-modal').classList.add('hidden');
            document.getElementById('client-modal').classList.remove('flex');
        }

        function handleSaveNewClient(e) {
            e.preventDefault();
            const name = document.getElementById('new-client-name').value.trim();
            const email = document.getElementById('new-client-email').value.trim();
            const phone = document.getElementById('new-client-phone').value.trim();

            const newClient = {
                id: 'cli_' + Date.now(),
                name,
                email,
                phone
            };

            dbClients.push(newClient);
            saveClients();
            closeNewClientModal();
            renderClientsList();
            showToast(`Client ${name} added successfully!`, 'success');
        }

        function deleteClient(id) {
            if (confirm('Are you sure you want to delete this client?')) {
                dbClients = dbClients.filter(c => c.id !== id);
                saveClients();
                renderClientsList();
                showToast('Client deleted.', 'success');
            }
        }

        function quickInvoiceForClient(clientId) {
            switchNav('create-invoice');
            setTimeout(() => {
                document.getElementById('inv-client-select').value = clientId;
            }, 50);
        }

        function renderPaymentsList() {
            const tbody = document.getElementById('payments-tbody');
            tbody.innerHTML = '';

            if (dbPayments.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400">No payment transactions recorded.</td></tr>`;
                return;
            }

            dbPayments.forEach(p => {
                const statusBadge = p.status === 'Successful' || p.status === 'Paid'
                    ? `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-600 rounded-full text-xs font-semibold border border-emerald-100">Successful</span>`
                    : `<span class="px-2.5 py-1 bg-amber-50 text-amber-600 rounded-full text-xs font-semibold border border-amber-100">Pending</span>`;

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="py-4 px-6 font-semibold text-slate-800">${p.id}</td>
                        <td class="py-4 px-6 text-brand-600 font-medium">${p.invoiceId}</td>
                        <td class="py-4 px-6 text-slate-700">${p.clientName}</td>
                        <td class="py-4 px-6 text-slate-500">${p.date}</td>
                        <td class="py-4 px-6 text-slate-600">${p.method}</td>
                        <td class="py-4 px-6 font-bold text-slate-800">₱${p.amount.toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                        <td class="py-4 px-6">${statusBadge}</td>
                    </tr>
                `;
            });
        }

        function initSettings() {
            if (currentUser) {
                document.getElementById('settings-company').value = currentUser.name;
                document.getElementById('settings-email').value = currentUser.email;
            }
        }

        function saveSettings() {
            const comp = document.getElementById('settings-company').value.trim();
            if (comp && currentUser) {
                currentUser.name = comp;
                document.getElementById('sidebar-user-name').innerText = comp;
                document.getElementById('user-avatar-initials').innerText = comp.substring(0, 2).toUpperCase();
                showToast('Settings updated successfully!', 'success');
            }
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.innerText = message;
            if (type === 'success') {
                toastIcon.className = 'fa-solid fa-circle-check text-emerald-400';
            } else {
                toastIcon.className = 'fa-solid fa-triangle-exclamation text-rose-400';
            }

            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3500);
        }

        // Window load check
        window.onload = function() {
            // Default focus
            document.getElementById('auth-email').focus();
        };
    </script>
</body>
</html>
